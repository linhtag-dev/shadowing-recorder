# Optional build-time setting for the non-public Stage 1 recorder spike. Supply
# one developer-prechecked ID locally; do not commit the selected value.
# VITE_SHADOWING_VIDEO_ID=<11-character-video-id>

# Runtime settings for the Node.js service. No credential is needed for the
# fixed-video proof of concept.
HOST=127.0.0.1
PORT=3000

# The default resolves to apps/web/dist. Override only when serving a build
# from another location.
# WEB_DIST_PATH=/absolute/path/to/apps/web/dist
