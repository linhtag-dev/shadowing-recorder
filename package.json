{
  "name": "shadowing-recorder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:contracts && npm run build --workspace=@shadowing-recorder/web && npm run build --workspace=@shadowing-recorder/api",
    "build:contracts": "npm run build --workspace=@shadowing-recorder/contracts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "container:build": "docker build --tag shadowing-recorder:local .",
    "container:run": "docker run --rm --publish 127.0.0.1:3000:3000 --name shadowing-recorder shadowing-recorder:local",
    "dev": "npm run build:contracts && concurrently --kill-others --names api,web --prefix-colors blue,green \"npm run dev --workspace=@shadowing-recorder/api\" \"npm run dev --workspace=@shadowing-recorder/web\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "preview": "npm run build && npm run start",
    "start": "npm run start --workspace=@shadowing-recorder/api",
    "test": "npm run build:contracts && vitest run",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "npm run build:contracts && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.3",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
